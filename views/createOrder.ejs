<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create New Order</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <h1 class="page-title">Create New Order</h1>

  <div class="form-card">
    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/orders/create" method="POST">
      <div class="form-group">
        <label for="customerName">Customer Name</label>
        <input type="text" id="customerName" name="customerName" placeholder="Enter your name" required>
      </div>

      <div class="form-group">
        <label for="productName">Product Name</label>
        <input type="text" id="productName" name="productName" placeholder="Enter product name" required>
      </div>

      <div class="form-group">
        <label for="quantity">Quantity</label>
        <input type="number" id="quantity" name="quantity" placeholder="Enter quantity" min="1" required>
      </div>

      <div class="form-group">
        <label for="orderDate">Order Date</label>
        <input type="date" id="orderDate" name="orderDate" required>
      </div>

      <button type="submit" class="btn-submit">Place Order</button>
      <a href="/orders" class="btn-back">Go Back</a>
    </form>
  </div>

</body>
</html>
