<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Orders</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <h1 class="page-title">Product Orders</h1>

  <div class="table-container">
    <table class="order-table">
      <thead>
        <tr>
          <th>Customer Name</th>
          <th>Product Name</th>
          <th>Quantity</th>
          <th>Order Date</th>
          <th>Total Price</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td><%= order.customerName %></td>
              <td><%= order.productName %></td>
              <td><%= order.quantity %></td>
              <td><%= new Date(order.orderDate).toLocaleDateString('en-US') %></td>
              <td>
                <div class="action-cell">
                  <a href="/orders/update/<%= order._id %>" class="btn-update">Update</a>
                  <a href="/orders/delete/<%= order._id %>" class="btn-delete" onclick="return confirm('Are you sure you want to delete this order?')">Delete</a>
                  <span class="price-text"><%= order.totalPrice ? order.totalPrice + ' ' : '' %>VND</span>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; padding: 25px;">No orders found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="center-btn-wrapper">
    <a href="/orders/create" class="btn-create">Create New Order</a>
  </div>

</body>
</html>
